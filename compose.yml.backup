services:
  postgres:
    image: postgres:17-alpine
    container_name: daily-planner-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: daily_planner
      POSTGRES_USER: planner
      POSTGRES_PASSWORD: planner_dev_password
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U planner -d daily_planner"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  postgres_data:
