import { useCallback, useEffect, useRef, useState } from 'react';
import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';

const API_URL = 'http://localhost:3000';

type Task = {
  id: string;
  title: string;
  description: string;
  completed: boolean;
  priority: 'low' | 'medium' | 'high';
  dueAt: string | null;
  startAt: string | null;
  endAt: string | null;
};

function anyDateKey(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

function anyDateMonthCells(month: Date): (Date | null)[] {
  const first = new Date(month.getFullYear(), month.getMonth(), 1);
  const offset = (first.getDay() + 6) % 7;
  const count = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
  const cells: (Date | null)[] = Array(offset).fill(null);
  for (let day = 1; day <= count; day++) {
    cells.push(new Date(month.getFullYear(), month.getMonth(), day));
  }
  while (cells.length % 7 !== 0) cells.push(null);
  return cells;
}

type TimeWheelProps = {
  label: string;
  value: string;
  onChange: (value: string) => void;
};

function TimeWheel({ label, value, onChange }: TimeWheelProps) {
  const itemHeight = 44;
  const [hourText, minuteText] = value.split(":");
  const selectedHour = Number(hourText) || 0;
  const selectedMinute = Number(minuteText) || 0;
  const hours = Array.from({ length: 24 }, (_, i) => i);
  const minutes = Array.from({ length: 12 }, (_, i) => i * 5);

  const hourRef = useRef<ScrollView>(null);
  const minuteRef = useRef<ScrollView>(null);
  const hourTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const minuteTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  function changeHour(hour: number) {
    onChange(`${String(hour).padStart(2, "0")}:${String(selectedMinute).padStart(2, "0")}`);
  }

  function changeMinute(minute: number) {
    onChange(`${String(selectedHour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`);
  }

  function snap(
    ref: React.RefObject<ScrollView | null>,
    offset: number,
    max: number,
    select: (index: number) => void,
  ) {
    const index = Math.max(0, Math.min(max, Math.round(offset / itemHeight)));
    const target = index * itemHeight;
    if (Math.abs(offset - target) > 0.5) {
      ref.current?.scrollTo({ y: target, animated: true });
    }
    select(index);
  }

  function scheduleHour(offset: number) {
    if (hourTimer.current) clearTimeout(hourTimer.current);
    hourTimer.current = setTimeout(() => {
      snap(hourRef, offset, 23, changeHour);
    }, 160);
  }

  function scheduleMinute(offset: number) {
    if (minuteTimer.current) clearTimeout(minuteTimer.current);
    minuteTimer.current = setTimeout(() => {
      snap(minuteRef, offset, 11, (i) => changeMinute(i * 5));
    }, 160);
  }

  useEffect(() => () => {
    if (hourTimer.current) clearTimeout(hourTimer.current);
    if (minuteTimer.current) clearTimeout(minuteTimer.current);
  }, []);

  return (
    <View style={styles.wheelField}>
      <Text style={styles.wheelLabel}>{label}</Text>
      <View style={[styles.wheelRow, { height: itemHeight * 3 }]}>
        <View style={[styles.wheelColumn, { height: itemHeight * 3 }]}>
          <View pointerEvents="none" style={styles.wheelSelection} />
          <ScrollView
            ref={hourRef}
            style={{ height: itemHeight * 3 }}
            contentContainerStyle={{ paddingVertical: itemHeight }}
            contentOffset={{ x: 0, y: selectedHour * itemHeight }}
            nestedScrollEnabled
            showsVerticalScrollIndicator={false}
            snapToInterval={itemHeight}
            decelerationRate="fast"
            scrollEventThrottle={16}
            onScroll={(e) => scheduleHour(e.nativeEvent.contentOffset.y)}
            onScrollEndDrag={(e) => scheduleHour(e.nativeEvent.contentOffset.y)}
            onMomentumScrollEnd={(e) => {
              if (hourTimer.current) clearTimeout(hourTimer.current);
              snap(hourRef, e.nativeEvent.contentOffset.y, 23, changeHour);
            }}
          >
            {hours.map((hour) => (
              <Pressable
                key={hour}
                style={[styles.wheelItem, { height: itemHeight }]}
                onPress={() => {
                  hourRef.current?.scrollTo({ y: hour * itemHeight, animated: true });
                  changeHour(hour);
                }}
              >
                <Text style={[
                  styles.wheelText,
                  hour === selectedHour && styles.wheelTextSelected,
                ]}>{String(hour).padStart(2, "0")}</Text>
              </Pressable>
            ))}
          </ScrollView>
        </View>

        <Text style={styles.wheelColon}>:</Text>

        <View style={[styles.wheelColumn, { height: itemHeight * 3 }]}>
          <View pointerEvents="none" style={styles.wheelSelection} />
          <ScrollView
            ref={minuteRef}
            style={{ height: itemHeight * 3 }}
            contentContainerStyle={{ paddingVertical: itemHeight }}
            contentOffset={{ x: 0, y: Math.round(selectedMinute / 5) * itemHeight }}
            nestedScrollEnabled
            showsVerticalScrollIndicator={false}
            snapToInterval={itemHeight}
            decelerationRate="fast"
            scrollEventThrottle={16}
            onScroll={(e) => scheduleMinute(e.nativeEvent.contentOffset.y)}
            onScrollEndDrag={(e) => scheduleMinute(e.nativeEvent.contentOffset.y)}
            onMomentumScrollEnd={(e) => {
              if (minuteTimer.current) clearTimeout(minuteTimer.current);
              snap(minuteRef, e.nativeEvent.contentOffset.y, 11, (i) => changeMinute(i * 5));
            }}
          >
            {minutes.map((minute) => (
              <Pressable
                key={minute}
                style={[styles.wheelItem, { height: itemHeight }]}
                onPress={() => {
                  minuteRef.current?.scrollTo({ y: (minute / 5) * itemHeight, animated: true });
                  changeMinute(minute);
                }}
              >
                <Text style={[
                  styles.wheelText,
                  minute === selectedMinute && styles.wheelTextSelected,
                ]}>{String(minute).padStart(2, "0")}</Text>
              </Pressable>
            ))}
          </ScrollView>
        </View>
      </View>
    </View>
  );
}

export default function TasksScreen() {
  const [tasks, setTasks] = useState<Task[]>([]);
  const [title, setTitle] = useState('');
  const [quickTitle, setQuickTitle] = useState('');
  const [description, setDescription] = useState('');
  const [priority, setPriority] = useState<Task['priority']>('medium');
  const [dueAt, setDueAt] = useState<string | null>(null);
  const [startTime, setStartTime] = useState('09:00');
  const [endTime, setEndTime] = useState('10:00');
  const [scheduleEnabled, setScheduleEnabled] = useState(false);
  const [showDatePicker, setShowDatePicker] = useState(false);
  const [calendarMonth, setCalendarMonth] = useState(() => new Date());

  function dateString(offset: number) {
    const date = new Date();
    date.setDate(date.getDate() + offset);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  function formatDueDate(value: string | null) {
    if (!value) return 'Без даты';
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day).toLocaleDateString('ru-RU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [filter, setFilter] = useState<'all' | 'active' | 'completed'>('all');

  const completedCount = tasks.filter((task) => task.completed).length;
  const activeCount = tasks.length - completedCount;
  const progress = tasks.length ? completedCount / tasks.length : 0;
  const visibleTasks = tasks.filter((task) => {
    if (filter === 'active') return !task.completed;
    if (filter === 'completed') return task.completed;
    return true;
  });

  const loadTasks = useCallback(async () => {
    try {
      setError('');
      const response = await fetch(`${API_URL}/tasks`);
      if (!response.ok) throw new Error();
      setTasks(await response.json());
    } catch {
      setError('Не удалось загрузить задачи. Проверь API на порту 3000.');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadTasks();
  }, [loadTasks]);

  async function addTask(titleOverride?: string) {
    const taskTitle = (titleOverride ?? title).trim();
    if (!taskTitle) {
      setError('Введите название задачи.');
      return;
    }

    try {
      setError('');
      const response = await fetch(`${API_URL}/tasks`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: taskTitle,
          description: description.trim(),
          priority,
          dueAt: dueAt
            ? new Date(`${dueAt}T12:00:00`).toISOString()
            : null,
          startAt: scheduleEnabled
            ? new Date(`${dueAt || dateString(0)}T${startTime}:00`).toISOString()
            : null,
          endAt: scheduleEnabled
            ? new Date(`${dueAt || dateString(0)}T${endTime}:00`).toISOString()
            : null,
        }),
      });
      if (!response.ok) throw new Error();

      setTitle('');
      setQuickTitle('');
      setDescription('');
      setPriority('medium');
      setDueAt(null);
      setScheduleEnabled(false);
      setStartTime('09:00');
      setEndTime('10:00');
      await loadTasks();
    } catch {
      setError('Не удалось сохранить задачу.');
    }
  }

  async function toggleTask(task: Task) {
    try {
      const response = await fetch(`${API_URL}/tasks/${task.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ completed: !task.completed }),
      });
      if (!response.ok) throw new Error();
      await loadTasks();
    } catch {
      setError('Не удалось изменить статус задачи.');
    }
  }

  async function deleteTask(id: string) {
    try {
      const response = await fetch(`${API_URL}/tasks/${id}`, {
        method: 'DELETE',
      });
      if (!response.ok) throw new Error();
      await loadTasks();
    } catch {
      setError('Не удалось удалить задачу.');
    }
  }

  return (
    <ScrollView contentContainerStyle={styles.page}>
      <Text style={styles.eyebrow}>МОЁ ПРОСТРАНСТВО</Text>
      <Text style={styles.heading}>Мои задачи</Text>
      <Text style={styles.subtitle}>
        Планируйте дела и отмечайте выполненное.
      </Text>

      {error ? <Text style={styles.error}>{error}</Text> : null}

      <View style={styles.quickAddCard}>
        <Text style={styles.quickAddTitle}>Быстро добавить</Text>
        <View style={styles.quickAddRow}>
          <TextInput
            value={quickTitle}
            onChangeText={setQuickTitle}
            placeholder="Что нужно сделать?"
            placeholderTextColor="#9293A7"
            style={styles.quickAddInput}
            returnKeyType="done"
            onSubmitEditing={() => addTask(quickTitle)}
            accessibilityLabel="Название новой задачи"
          />
          <Pressable
            style={[
              styles.quickAddButton,
              !quickTitle.trim() && styles.quickAddButtonDisabled,
            ]}
            onPress={() => addTask(quickTitle)}
            accessibilityRole="button"
            accessibilityLabel="Добавить задачу"
          >
            <Text style={styles.quickAddButtonText}>+</Text>
          </Pressable>
        </View>
        <Text style={styles.quickAddHint}>
          Остальные параметры можно настроить в полной форме ниже.
        </Text>
      </View>

      <View style={styles.form}>
        <Text style={styles.formTitle}>Новая задача</Text>
        <TextInput
          value={title}
          onChangeText={setTitle}
          placeholder="Название задачи"
          placeholderTextColor="#85899A"
          style={styles.input}
        />
        <TextInput
          value={description}
          onChangeText={setDescription}
          placeholder="Описание (необязательно)"
          placeholderTextColor="#85899A"
          style={[styles.input, styles.description]}
          multiline
        />

        <Text style={styles.label}>Время в расписании</Text>
        <Pressable
          style={styles.anyDateToggle}
          onPress={() => setScheduleEnabled((value) => !value)}
        >
          <Text style={styles.anyDateToggleText}>
            {scheduleEnabled ? '✓ Добавить в расписание' : '+ Указать время начала и окончания'}
          </Text>
        </Pressable>

        {scheduleEnabled && (
          <View style={styles.scheduleFields}>
            <Text style={styles.label}>Время начала и окончания</Text>
            <Text style={styles.scheduleDateHint}>
              Дата: {formatDueDate(dueAt || dateString(0))}
            </Text>
            <View style={styles.scheduleTimeRow}>
              <TimeWheel label="Начало" value={startTime} onChange={setStartTime} />
              <TimeWheel label="Окончание" value={endTime} onChange={setEndTime} />
            </View>
          </View>
          )}
        <Text style={styles.label}>Дата выполнения</Text>
        <View style={styles.dateSummary}>
          <Text style={styles.dateSummaryText}>
            {dueAt ? `📅 ${formatDueDate(dueAt)}` : '📅 Дата не выбрана'}
          </Text>
        </View>
        <View style={styles.dateQuickActions}>
          <Pressable
            style={styles.dateQuickButton}
            onPress={() => { setDueAt(dateString(0)); setShowDatePicker(false); }}
          >
            <Text style={styles.dateQuickText}>Сегодня</Text>
          </Pressable>
          <Pressable
            style={styles.dateQuickButton}
            onPress={() => { setDueAt(dateString(1)); setShowDatePicker(false); }}
          >
            <Text style={styles.dateQuickText}>Завтра</Text>
          </Pressable>
          <Pressable
            style={styles.dateQuickButton}
            onPress={() => { setDueAt(null); setShowDatePicker(false); }}
          >
            <Text style={styles.dateQuickText}>Без даты</Text>
          </Pressable>
        </View>
        <Pressable
          style={styles.anyDateToggle}
          onPress={() => setShowDatePicker((value) => !value)}
        >
          <Text style={styles.anyDateToggleText}>
            {showDatePicker ? 'Закрыть календарь ▲' : 'Выбрать другую дату ▾'}
          </Text>
        </Pressable>
        {showDatePicker && (
          <View style={styles.anyDateCalendar}>
            <View style={styles.anyDateHeader}>
              <Pressable
                style={styles.anyDateNav}
                onPress={() => setCalendarMonth((month) =>
                  new Date(month.getFullYear(), month.getMonth() - 1, 1)
                )}
              >
                <Text style={styles.anyDateNavText}>‹</Text>
              </Pressable>
              <Text style={styles.anyDateMonth}>
                {calendarMonth.toLocaleDateString('ru-RU', {
                  month: 'long',
                  year: 'numeric',
                })}
              </Text>
              <Pressable
                style={styles.anyDateNav}
                onPress={() => setCalendarMonth((month) =>
                  new Date(month.getFullYear(), month.getMonth() + 1, 1)
                )}
              >
                <Text style={styles.anyDateNavText}>›</Text>
              </Pressable>
            </View>
            <View style={styles.anyDateGrid}>
              {['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].map((weekday) => (
                <View key={weekday} style={styles.anyDateCell}>
                  <Text style={styles.anyDateWeekday}>{weekday}</Text>
                </View>
              ))}
              {anyDateMonthCells(calendarMonth).map((day, index) => {
                if (!day) {
                  return (
                    <View
                      key={`empty-${index}`}
                      style={[styles.anyDateCell, styles.anyDateEmptyDay]}
                    />
                  );
                }

                const key = anyDateKey(day);
                const selected = dueAt === key;
                const today = anyDateKey(new Date()) === key;
                const dayTasks = tasks.filter((task) => {
                  if (!task.dueAt) return false;
                  const taskDate = new Date(task.dueAt);
                  if (Number.isNaN(taskDate.getTime())) return false;
                  return anyDateKey(taskDate) === key;
                });

                return (
                  <Pressable
                    key={key}
                    style={[
                      styles.anyDateCell,
                      styles.anyDateDay,
                      selected && styles.anyDateDaySelected,
                    ]}
                    onPress={() => {
                      setDueAt(key);
                      setShowDatePicker(false);
                    }}
                  >
                    <Text
                      style={[
                        styles.anyDateDayText,
                        selected && styles.anyDateDayTextSelected,
                        today && !selected && styles.anyDateTodayText,
                      ]}
                    >
                      {day.getDate()}
                    </Text>
                    <View style={styles.anyDateTaskCell}>
                      {dayTasks.slice(0, 3).map((task) => (
                        <Text
                          key={task.id}
                          numberOfLines={1}
                          style={[
                            styles.anyDateTaskText,
                            selected && styles.anyDateTaskTextSelected,
                            task.completed && styles.anyDateTaskTextCompleted,
                          ]}
                        >
                          {task.title}
                        </Text>
                      ))}
                      {dayTasks.length > 3 && (
                        <Text
                          numberOfLines={1}
                          style={[
                            styles.anyDateTaskText,
                            selected && styles.anyDateTaskTextSelected,
                          ]}
                        >
                          +{dayTasks.length - 3}
                        </Text>
                      )}
                    </View>
                  </Pressable>
                );
              })}
            </View>
          </View>
        )}
        <Text style={styles.label}>Приоритет</Text>
        <View style={styles.priorities}>
          {([
            ['low', 'Низкий'],
            ['medium', 'Средний'],
            ['high', 'Высокий'],
          ] as const).map(([value, label]) => (
            <Pressable
              key={value}
              onPress={() => setPriority(value)}
              style={[
                styles.priorityButton,
                priority === value && styles.prioritySelected,
              ]}
            >
              <Text
                style={[
                  styles.priorityText,
                  priority === value && styles.priorityTextSelected,
                ]}
              >
                {label}
              </Text>
            </Pressable>
          ))}
        </View>

        <Pressable style={styles.addButton} onPress={addTask}>
          <Text style={styles.addButtonText}>+ Добавить задачу</Text>
        </Pressable>
      </View>

      <View style={styles.progressCard}>
        <View style={styles.progressTop}>
          <View>
            <Text style={styles.progressTitle}>Ваш прогресс</Text>
            <Text style={styles.progressSubtitle}>
              {completedCount} из {tasks.length} задач выполнено
            </Text>
          </View>
          <Text style={styles.progressPercent}>
            {Math.round(progress * 100)}%
          </Text>
        </View>
        <View style={styles.progressTrack}>
          <View
            style={[styles.progressFill, { width: `${progress * 100}%` }]}
          />
        </View>
        <View style={styles.progressStats}>
          <Text style={styles.statText}>● {activeCount} активных</Text>
          <Text style={styles.statDone}>● {completedCount} выполнено</Text>
        </View>
      </View>

      <View style={styles.listHeader}>
        <Text style={styles.listTitle}>Мои задачи</Text>
        <Text style={styles.counter}>{visibleTasks.length}</Text>
      </View>

      <View style={styles.filters}>
        {([
          ['all', 'Все'],
          ['active', 'Активные'],
          ['completed', 'Выполненные'],
        ] as const).map(([value, label]) => (
          <Pressable
            key={value}
            onPress={() => setFilter(value)}
            style={[
              styles.filterButton,
              filter === value && styles.filterButtonActive,
            ]}
          >
            <Text
              style={[
                styles.filterText,
                filter === value && styles.filterTextActive,
              ]}
            >
              {label}
            </Text>
          </Pressable>
        ))}
      </View>

      {loading ? (
        <ActivityIndicator size="large" color="#6B5CE7" />
      ) : tasks.length === 0 ? (
        <Text style={styles.empty}>Задач пока нет — добавьте первую выше.</Text>
      ) : visibleTasks.length === 0 ? (
        <Text style={styles.empty}>
          {filter === 'active'
            ? 'Активных задач нет. Отличная работа!'
            : 'Выполненных задач пока нет.'}
        </Text>
      ) : (
        visibleTasks.map((task) => (
          <View key={task.id} style={styles.taskCard}>
            <Pressable
              onPress={() => toggleTask(task)}
              style={styles.taskRow}
            >
              <View
                style={[
                  styles.checkbox,
                  task.completed && styles.checkboxDone,
                ]}
              >
                <Text style={styles.checkmark}>
                  {task.completed ? '✓' : ''}
                </Text>
              </View>
              <View style={styles.taskBody}>
                <Text
                  style={[
                    styles.taskTitle,
                    task.completed && styles.completedTitle,
                  ]}
                >
                  {task.title}
                </Text>
                {task.description ? (
                  <Text style={styles.taskDescription}>
                    {task.description}
                  </Text>
                ) : null}
                <View style={styles.metaRow}>
                  <Text
                    style={[
                      styles.priorityBadge,
                      task.priority === 'high' && styles.priorityHigh,
                      task.priority === 'medium' && styles.priorityMedium,
                      task.priority === 'low' && styles.priorityLow,
                    ]}
                  >
                    {task.priority === 'high'
                      ? 'Высокий приоритет'
                      : task.priority === 'low'
                        ? 'Низкий приоритет'
                        : 'Средний приоритет'}
                  </Text>
                  <Text
                    style={[
                      styles.statusBadge,
                      task.completed && styles.statusDone,
                    ]}
                  >
                    {task.completed ? '✓ Выполнена' : 'В процессе'}
                  </Text>
                </View>
              </View>
            </Pressable>
            <Pressable
              onPress={() => deleteTask(task.id)}
              style={styles.deleteButton}
            >
              <Text style={styles.deleteText}>Удалить</Text>
            </Pressable>
          </View>
        ))
      )}
    </ScrollView>
  );
}

