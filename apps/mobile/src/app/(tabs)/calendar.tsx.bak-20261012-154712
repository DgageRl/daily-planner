import { useCallback, useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { useFocusEffect } from 'expo-router';

const API_URL = 'http://localhost:3000';

type Task = {
  id: string;
  title: string;
  description: string;
  completed: boolean;
  priority: 'low' | 'medium' | 'high';
  dueAt: string | null;
};

const WEEKDAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
type CalendarView = 'month' | 'week' | 'day';

const MONTHS = [
  'Январь', 'Февраль', 'Март', 'Апрель',
  'Май', 'Июнь', 'Июль', 'Август',
  'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь',
];

function dateKey(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

function taskDateKey(value: string | null) {
  if (!value) return null;

  // Для дат без времени сохраняем исходную календарную дату.
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;

  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : dateKey(date);
}

function sameMonth(a: Date, b: Date) {
  return a.getFullYear() === b.getFullYear()
    && a.getMonth() === b.getMonth();
}

export default function CalendarScreen() {
  const [month, setMonth] = useState(() => {
    const now = new Date();
    return new Date(now.getFullYear(), now.getMonth(), 1);
  });
  const [selectedDay, setSelectedDay] = useState(() => dateKey(new Date()));
  const [viewMode, setViewMode] = useState<CalendarView>('month');
  const [tasks, setTasks] = useState<Task[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const loadTasks = useCallback(async () => {
    try {
      setError('');
      const response = await fetch(`${API_URL}/tasks`);

      if (!response.ok) {
        throw new Error(`Ошибка загрузки: ${response.status}`);
      }

      const data = await response.json();
      if (!Array.isArray(data)) {
        throw new Error('Сервер вернул неожиданный формат задач');
      }

      setTasks(data);
    } catch (e) {
      setError(
        e instanceof Error ? e.message : 'Не удалось загрузить задачи'
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      loadTasks();
    }, [loadTasks])
  );

  const calendarDays = useMemo(() => {
    const firstDay = new Date(
      month.getFullYear(),
      month.getMonth(),
      1
    );

    // Понедельник — первый день недели.
    const offset = (firstDay.getDay() + 6) % 7;
    const gridStart = new Date(
      month.getFullYear(),
      month.getMonth(),
      1 - offset
    );

    return Array.from({ length: 42 }, (_, index) => {
      const day = new Date(gridStart);
      day.setDate(gridStart.getDate() + index);
      return day;
    });
  }, [month]);

  const visibleCalendarDays = useMemo(() => {
    if (viewMode === 'month') return calendarDays;

    const selected = new Date(`${selectedDay}T12:00:00`);

    if (viewMode === 'day') {
      return [new Date(
        selected.getFullYear(),
        selected.getMonth(),
        selected.getDate()
      )];
    }

    const offset = (selected.getDay() + 6) % 7;
    const weekStart = new Date(
      selected.getFullYear(),
      selected.getMonth(),
      selected.getDate() - offset
    );
    const weekEnd = new Date(
      weekStart.getFullYear(),
      weekStart.getMonth(),
      weekStart.getDate() + 6
    );

    return calendarDays.filter((day) => day >= weekStart && day <= weekEnd);
  }, [calendarDays, selectedDay, viewMode]);

  const tasksByDate = useMemo(() => {
    const grouped: Record<string, Task[]> = {};

    tasks.forEach((task) => {
      const key = taskDateKey(task.dueAt);
      if (!key) return;
      if (!grouped[key]) grouped[key] = [];
      grouped[key].push(task);
    });

    return grouped;
  }, [tasks]);

  const selectedTasks = tasksByDate[selectedDay] ?? [];
  const todayKey = dateKey(new Date());

  function changePeriod(amount: number) {
    if (viewMode === 'month') {
      const next = new Date(
        month.getFullYear(),
        month.getMonth() + amount,
        1
      );
      setMonth(next);
      setSelectedDay(dateKey(next));
      return;
    }

    const next = new Date(`${selectedDay}T12:00:00`);
    next.setDate(next.getDate() + amount * (viewMode === 'week' ? 7 : 1));
    setSelectedDay(dateKey(next));
    setMonth(new Date(next.getFullYear(), next.getMonth(), 1));
  }

  return (
    <ScrollView
      style={styles.screen}
      contentContainerStyle={styles.content}
    >
      <View style={styles.header}>
        <View>
          <Text style={styles.eyebrow}>ТВОЙ ПЛАН</Text>
          <Text style={styles.title}>Календарь</Text>
          <Text style={styles.subtitle}>
            Все важные дела в одном месте
          </Text>
        </View>
        <View style={styles.headerIcon}>
          <Text style={styles.headerEmoji}>📅</Text>
        </View>
      </View>

      <View style={styles.monthCard}>
        <View style={styles.viewSwitcher}>
          {([
            ['week', 'Неделя'],
            ['month', 'Месяц'],
          ] as const).map(([mode, label]) => (
            <Pressable
              key={mode}
              onPress={() => setViewMode(mode)}
              style={[
                styles.viewOption,
                viewMode === mode && styles.viewOptionActive,
              ]}
            >
              <Text
                style={[
                  styles.viewOptionText,
                  viewMode === mode && styles.viewOptionTextActive,
                ]}
              >
                {label}
              </Text>
            </Pressable>
          ))}
        </View>

        <View style={styles.monthHeader}>
          <Pressable
            accessibilityLabel="Предыдущий период"
            onPress={() => changePeriod(-1)}
            style={styles.arrowButton}
          >
            <Text style={styles.arrow}>‹</Text>
          </Pressable>

          <View style={styles.monthTitleWrap}>
            <Text style={styles.monthTitle}>
              {viewMode === 'month'
                ? MONTHS[month.getMonth()]
                : viewMode === 'week'
                  ? 'Неделя'
                  : 'Выбранный день'}
            </Text>
            <Text style={styles.year}>
              {viewMode === 'month'
                ? month.getFullYear()
                : new Date(`${selectedDay}T12:00:00`).toLocaleDateString(
                    'ru-RU',
                    { day: 'numeric', month: 'long', year: 'numeric' }
                  )}
            </Text>
          </View>

          <Pressable
            accessibilityLabel="Следующий период"
            onPress={() => changePeriod(1)}
            style={styles.arrowButton}
          >
            <Text style={styles.arrow}>›</Text>
          </Pressable>
        </View>

        <Pressable
          onPress={() => {
            const now = new Date();
            setMonth(new Date(now.getFullYear(), now.getMonth(), 1));
            setSelectedDay(dateKey(now));
          }}
          style={styles.todayButton}
        >
          <Text style={styles.todayButtonText}>Сегодня</Text>
        </Pressable>

        {viewMode !== 'day' && (
          <View style={styles.weekRow}>
            {WEEKDAYS.map((day) => (
              <View key={day} style={styles.weekCell}>
                <Text style={styles.weekText}>{day}</Text>
              </View>
            ))}
          </View>
        )}

        <View style={styles.daysGrid}>
          {visibleCalendarDays.map((day) => {
            const key = dateKey(day);
            const inMonth = sameMonth(day, month);
            const isSelected = key === selectedDay;
            const isToday = key === todayKey;
            const dayTasks = tasksByDate[key] ?? [];
            const hasActive = dayTasks.some((task) => !task.completed);
            const hasCompleted = dayTasks.some((task) => task.completed);

            return (
              <Pressable
                key={key}
                onPress={() => setSelectedDay(key)}
                style={[
                  styles.dayCell,
                  viewMode === 'day' && styles.singleDayCell,
                  viewMode === 'week' && styles.weekDayCell,
                  viewMode === 'week' && isSelected && styles.weekDayCellSelected,
                ]}
              >
                {viewMode === 'week' && (
                  <Text
                    style={[
                      styles.weekDayName,
                      isSelected && styles.weekDayNameSelected,
                    ]}
                  >
                    {WEEKDAYS[(day.getDay() + 6) % 7]}
                  </Text>
                )}
                <View
                  style={[
                    styles.dayNumberWrap,
                    isSelected && styles.selectedDay,
                    isToday && !isSelected && styles.todayDay,
                  ]}
                >
                  <Text
                    style={[
                      styles.dayNumber,
                      !inMonth && styles.otherMonthText,
                      isSelected && styles.selectedDayText,
                      isToday && !isSelected && styles.todayText,
                    ]}
                  >
                    {day.getDate()}
                  </Text>
                </View>

                <View style={styles.dots}>
                  {hasActive && (
                    <View
                      style={[
                        styles.dot,
                        { backgroundColor: '#6B5CE7' },
                      ]}
                    />
                  )}
                  {hasCompleted && (
                    <View
                      style={[
                        styles.dot,
                        { backgroundColor: '#42B883' },
                      ]}
                    />
                  )}
                  {dayTasks.length > 2 && (
                    <View
                      style={[
                        styles.dot,
                        { backgroundColor: '#F2B84B' },
                      ]}
                    />
                  )}
                </View>
              </Pressable>
            );
          })}
        </View>

        <View style={styles.legend}>
          <View style={styles.legendItem}>
            <View style={[styles.legendDot, { backgroundColor: '#6B5CE7' }]} />
            <Text style={styles.legendText}>В процессе</Text>
          </View>
          <View style={styles.legendItem}>
            <View style={[styles.legendDot, { backgroundColor: '#42B883' }]} />
            <Text style={styles.legendText}>Выполнено</Text>
          </View>
        </View>
      </View>

      <View style={styles.agendaHeader}>
        <View>
          <Text style={styles.agendaTitle}>Планы на день</Text>
          <Text style={styles.agendaDate}>
            {new Date(`${selectedDay}T12:00:00`).toLocaleDateString(
              'ru-RU',
              { day: 'numeric', month: 'long', weekday: 'long' }
            )}
          </Text>
        </View>
        <View style={styles.countBadge}>
          <Text style={styles.countText}>{selectedTasks.length}</Text>
        </View>
      </View>

      {loading ? (
        <ActivityIndicator
          color="#6B5CE7"
          size="large"
          style={styles.loader}
        />
      ) : error ? (
        <View style={styles.emptyCard}>
          <Text style={styles.emptyEmoji}>⚠️</Text>
          <Text style={styles.emptyTitle}>Не удалось загрузить задачи</Text>
          <Text style={styles.emptyText}>{error}</Text>
          <Pressable onPress={loadTasks} style={styles.retryButton}>
            <Text style={styles.retryText}>Повторить</Text>
          </Pressable>
        </View>
      ) : selectedTasks.length === 0 ? (
        <View style={styles.emptyCard}>
          <Text style={styles.emptyEmoji}>🌿</Text>
          <Text style={styles.emptyTitle}>На этот день пока пусто</Text>
          <Text style={styles.emptyText}>
            Добавь задаче дату в разделе «Задачи», и она появится здесь.
          </Text>
        </View>
      ) : (
        <View style={styles.taskList}>
          {selectedTasks.map((task) => (
            <View key={task.id} style={styles.taskCard}>
              <View
                style={[
                  styles.taskAccent,
                  task.completed && styles.taskAccentDone,
                  task.priority === 'high' && !task.completed
                    && styles.taskAccentHigh,
                ]}
              />
              <View style={styles.taskContent}>
                <Text
                  style={[
                    styles.taskTitle,
                    task.completed && styles.taskTitleDone,
                  ]}
                >
                  {task.title}
                </Text>
                {!!task.description && (
                  <Text style={styles.taskDescription} numberOfLines={2}>
                    {task.description}
                  </Text>
                )}
                <View style={styles.taskMeta}>
                  <Text
                    style={[
                      styles.priorityText,
                      task.priority === 'high' && styles.highPriority,
                      task.priority === 'low' && styles.lowPriority,
                    ]}
                  >
                    {task.priority === 'high'
                      ? 'Высокий приоритет'
                      : task.priority === 'low'
                        ? 'Низкий приоритет'
                        : 'Обычный приоритет'}
                  </Text>
                  <Text
                    style={[
                      styles.statusText,
                      task.completed && styles.statusDone,
                    ]}
                  >
                    {task.completed ? '✓ Выполнена' : 'В процессе'}
                  </Text>
                </View>
              </View>
            </View>
          ))}
        </View>
      )}

      <View style={styles.footerNote}>
        <Text style={styles.footerIcon}>💡</Text>
        <Text style={styles.footerText}>
          Задачи появятся в календаре, когда у них будет указана дата.
        </Text>
      </View>
    </ScrollView>
  );
}

